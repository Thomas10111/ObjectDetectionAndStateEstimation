<?xml version="1.0"?>
<!--
  Empty 6 x 6 m arena with walls and one target ball, for the search
  experiment (odse_driving, world:=arena). The car starts in the middle facing
  +x. experiment.launch.py moves the ball to target_x, target_y.
-->
<sdf version="1.9">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>6 6</size></plane></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
        <!-- 1 m grid to judge distances -->
        <visual name="grid_x">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>6 0.01 0.001</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <visual name="grid_y">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry><box><size>0.01 6 0.001</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls, 30 cm high -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_collision"><pose>3 0 0.15 0 0 0</pose><geometry><box><size>0.05 6 0.3</size></box></geometry></collision>
        <visual name="north_visual"><pose>3 0 0.15 0 0 0</pose><geometry><box><size>0.05 6 0.3</size></box></geometry></visual>
        <collision name="south_collision"><pose>-3 0 0.15 0 0 0</pose><geometry><box><size>0.05 6 0.3</size></box></geometry></collision>
        <visual name="south_visual"><pose>-3 0 0.15 0 0 0</pose><geometry><box><size>0.05 6 0.3</size></box></geometry></visual>
        <collision name="east_collision"><pose>0 -3 0.15 0 0 0</pose><geometry><box><size>6 0.05 0.3</size></box></geometry></collision>
        <visual name="east_visual"><pose>0 -3 0.15 0 0 0</pose><geometry><box><size>6 0.05 0.3</size></box></geometry></visual>
        <collision name="west_collision"><pose>0 3 0.15 0 0 0</pose><geometry><box><size>6 0.05 0.3</size></box></geometry></collision>
        <visual name="west_visual"><pose>0 3 0.15 0 0 0</pose><geometry><box><size>6 0.05 0.3</size></box></geometry></visual>
      </link>
    </model>

    <model name="target_ball">
      <static>true</static>
      <pose>1.8 -0.3 0.1 0 0 0</pose>
      <!-- Pose with its name on /model/target_ball/pose_static (bridged to /world_poses) -->
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <static_update_frequency>10</static_update_frequency>
      </plugin>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
