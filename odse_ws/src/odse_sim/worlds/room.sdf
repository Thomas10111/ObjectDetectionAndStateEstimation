<?xml version="1.0"?>
<!--
  4 x 4 m room with a few objects to drive to and around.
  Object sizes are in the range the F200 sees well (0.2 to 1.0 m away).
-->
<sdf version="1.9">
  <world name="room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>4 4</size></plane></geometry>
          <material><ambient>0.7 0.65 0.55 1</ambient><diffuse>0.7 0.65 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls, 30 cm high -->
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="north_collision"><pose>2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry></collision>
        <visual name="north_visual"><pose>2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry></visual>
        <collision name="south_collision"><pose>-2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry></collision>
        <visual name="south_visual"><pose>-2 0 0.15 0 0 0</pose><geometry><box><size>0.05 4 0.3</size></box></geometry></visual>
        <collision name="east_collision"><pose>0 -2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry></collision>
        <visual name="east_visual"><pose>0 -2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry></visual>
        <collision name="west_collision"><pose>0 2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry></collision>
        <visual name="west_visual"><pose>0 2 0.15 0 0 0</pose><geometry><box><size>4 0.05 0.3</size></box></geometry></visual>
      </link>
    </model>

    <!-- Objects -->
    <model name="red_box">
      <static>true</static>
      <pose>1.0 0.3 0.1 0 0 0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_cylinder">
      <static>true</static>
      <pose>0.6 -0.9 0.15 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.08</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_ball">
      <static>true</static>
      <pose>-0.8 1.0 0.12 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="v">
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
