<?xml version="1.0"?>
<!--
  LEGO Technic car with front axle steering, Jetson Orin, RealSense F200 and IMU.

  Dimensions measured on the real car (October 2026). base_link sits on the
  floor below the center of the rear axle, x forward, z up (REP-103).
  Camera values follow docs/camera_f200.md.
-->
<robot name="lego_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Measured -->
  <xacro:property name="wheelbase" value="0.25"/>
  <xacro:property name="track" value="0.18"/>
  <xacro:property name="wheel_radius" value="0.0425"/>
  <xacro:property name="body_length" value="0.42"/>
  <xacro:property name="body_width" value="0.28"/>
  <xacro:property name="body_height" value="0.15"/>
  <!-- 120 cm turning circle: atan(0.25 / 0.6) = 0.395 rad (22.6 deg) -->
  <xacro:property name="steering_limit" value="0.40"/>

  <!-- Camera: assumed 15 cm above the floor, over the front axle -->
  <xacro:arg name="camera_x" default="0.25"/>
  <xacro:arg name="camera_z" default="0.15"/>

  <!-- Estimated -->
  <xacro:property name="wheel_width" value="0.035"/>
  <xacro:property name="body_mass" value="1.2"/>
  <xacro:property name="wheel_mass" value="0.05"/>
  <xacro:property name="body_overhang_rear" value="0.085"/>
  <xacro:property name="body_bottom" value="0.03"/>
  <!-- Distance between the two steering pivots, slightly less than the track -->
  <xacro:property name="kingpin_width" value="0.15"/>
  <xacro:property name="max_speed" value="1.0"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m * (y * y + z * z) / 12}" ixy="0" ixz="0"
               iyy="${m * (x * x + z * z) / 12}" iyz="0"
               izz="${m * (x * x + y * y) / 12}"/>
    </inertial>
  </xacro:macro>

  <material name="lego_grey"><color rgba="0.55 0.57 0.6 1"/></material>
  <material name="tire"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="camera_black"><color rgba="0.05 0.05 0.05 1"/></material>

  <!-- Body -->

  <link name="base_link"/>

  <link name="chassis">
    <visual>
      <geometry><box size="${body_length} ${body_width - 2 * wheel_width} ${body_height - body_bottom}"/></geometry>
      <material name="lego_grey"/>
    </visual>
    <collision>
      <geometry><box size="${body_length} ${body_width - 2 * wheel_width} ${body_height - body_bottom}"/></geometry>
    </collision>
    <xacro:box_inertia m="${body_mass}" x="${body_length}"
                       y="${body_width - 2 * wheel_width}" z="${body_height - body_bottom}"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="${body_length / 2 - body_overhang_rear} 0 ${(body_height + body_bottom) / 2}"/>
  </joint>

  <!-- Wheels -->

  <xacro:macro name="wheel" params="name">
    <link name="${name}_wheel">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="tire"/>
      </visual>
      <collision>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"
                 ixy="0" ixz="0"
                 iyy="${wheel_mass * wheel_radius * wheel_radius / 2}" iyz="0"
                 izz="${wheel_mass * (3 * wheel_radius * wheel_radius + wheel_width * wheel_width) / 12}"/>
      </inertial>
    </link>
    <gazebo reference="${name}_wheel">
      <collision>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- Rear wheels: driven -->
  <xacro:macro name="rear_wheel" params="side y">
    <xacro:wheel name="rear_${side}"/>
    <joint name="rear_${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rear_${side}_wheel"/>
      <origin xyz="0 ${y} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Front wheels: steered through a hub, free rolling -->
  <xacro:macro name="front_wheel" params="side y">
    <link name="front_${side}_hub">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_hub"/>
      <origin xyz="${wheelbase} ${y} ${wheel_radius}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit}" upper="${steering_limit}" effort="5" velocity="3"/>
    </joint>
    <xacro:wheel name="front_${side}"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_hub"/>
      <child link="front_${side}_wheel"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel side="left" y="${track / 2}"/>
  <xacro:rear_wheel side="right" y="${-track / 2}"/>
  <xacro:front_wheel side="left" y="${track / 2}"/>
  <xacro:front_wheel side="right" y="${-track / 2}"/>

  <!-- RealSense F200 -->

  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.11 0.03"/></geometry>
      <material name="camera_black"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="$(arg camera_x) 0 $(arg camera_z)"/>
  </joint>

  <!-- Optical frames: z forward, x right, y down, as image messages expect -->
  <xacro:macro name="optical_frame" params="name">
    <link name="${name}_optical_frame"/>
    <joint name="${name}_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="${name}_optical_frame"/>
      <origin rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>
  </xacro:macro>
  <xacro:optical_frame name="camera_color"/>
  <xacro:optical_frame name="camera_depth"/>

  <gazebo reference="camera_link">
    <!-- Color: the real camera does 1920x1080; reduced to spare the laptop GPU -->
    <sensor name="color" type="camera">
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <topic>camera/color/image_raw</topic>
      <camera_info_topic>camera/color/camera_info</camera_info_topic>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.2217</horizontal_fov>  <!-- 70 deg -->
        <image><width>640</width><height>360</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>10</far></clip>
      </camera>
    </sensor>
    <!-- Depth: 640x480, 68 x 54 deg, 0.2 to 1.0 m -->
    <sensor name="depth" type="depth_camera">
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <topic>camera/depth/image_rect_raw</topic>
      <camera_info_topic>camera/depth/camera_info</camera_info_topic>
      <gz_frame_id>camera_depth_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.1868</horizontal_fov>  <!-- 68 deg -->
        <image><width>640</width><height>480</height><format>R_FLOAT32</format></image>
        <clip><near>0.2</near><far>1.0</far></clip>
        <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- IMU (stands in for the MPU-6050) -->

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${wheelbase / 2} 0 0.08"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <update_rate>200</update_rate>
      <always_on>true</always_on>
      <topic>imu/data_raw</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Gazebo plugins -->

  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>${kingpin_width}</kingpin_width>
      <steering_limit>${steering_limit}</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>${-max_speed}</min_velocity>
      <max_velocity>${max_speed}</max_velocity>
      <min_acceleration>-2</min_acceleration>
      <max_acceleration>2</max_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
